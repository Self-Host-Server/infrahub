# Conda env name, used by the Makefile
conda_name=infrahub

# Infrahub image tag (registry.opsmill.io/opsmill/infrahub)
VERSION=1.11.10

# --- Secrets (required: compose.yml falls back to public upstream defaults) ---
# UI login for user "admin"
INFRAHUB_INITIAL_ADMIN_PASSWORD=replace_me
# API tokens, any UUID: python3 -c "import uuid; print(uuid.uuid4())"
INFRAHUB_INITIAL_ADMIN_TOKEN=replace_me
INFRAHUB_INITIAL_AGENT_TOKEN=replace_me
# Signs session JWTs: openssl rand -hex 32
INFRAHUB_SECURITY_SECRET_KEY=replace_me
# Read on first start only: changing these later needs `docker compose down -v`
INFRAHUB_DB_PASSWORD=replace_me
INFRAHUB_BROKER_PASSWORD=replace_me
INFRAHUB_TASKMANAGER_DB_PASSWORD=replace_me

# --- Optional ---
# Public URL Infrahub is reached at, e.g. https://infrahub.example.com
INFRAHUB_PUBLIC_URL=
# true lets logged-out visitors read everything
INFRAHUB_ALLOW_ANONYMOUS_ACCESS=false
INFRAHUB_TELEMETRY_OPTOUT=false

# --- SSO via OIDC, e.g. Authentik (optional) ---
# Uncomment and fill these in to show the SSO button on the login page.
# Provider redirect URI: ${INFRAHUB_PUBLIC_URL}/auth/oidc/provider1/callback
# INFRAHUB_SECURITY_OIDC_PROVIDERS=["provider1"]
# INFRAHUB_OIDC_PROVIDER1_CLIENT_ID=
# INFRAHUB_OIDC_PROVIDER1_CLIENT_SECRET=
# Authentik: https://authentik.example.com/application/o/<app-slug>/.well-known/openid-configuration
# JumpCloud: https://oauth.id.jumpcloud.com/.well-known/openid-configuration
# INFRAHUB_OIDC_PROVIDER1_DISCOVERY_URL=
# INFRAHUB_OIDC_PROVIDER1_DISPLAY_LABEL=Sign in with Authentik
# INFRAHUB_OIDC_PROVIDER1_ICON=mdi:shield-key
# Group assigned on a user's first SSO login. Provider "groups" claims are also
# matched by name to existing Infrahub groups on every login.
# INFRAHUB_SECURITY_SSO_USER_DEFAULT_GROUP=

# --- ipam-sync: fills IPAM from Proxmox VE and a network scan every 15 minutes (optional) ---
# Leave PROXMOX_URL empty to run the network scan only, no Proxmox sync.
# Form: https://<node-ip>:8006
PROXMOX_URL=
PROXMOX_TOKEN_ID=replace_me
PROXMOX_TOKEN_SECRET=replace_me
PROXMOX_VERIFY_TLS=false
IPAM_SCAN_SUBNETS=192.168.1.0/24
IPAM_SYNC_INTERVAL_MINUTES=15
IPAM_STALE_DAYS=7
